# IONOS Deploy Now — Apache config for a PRERENDERED Nuxt static site.
#
# NOTE: This is NOT the classic "rewrite everything to /index.html" SPA rule.
# `nuxt generate` prerenders each route to its own HTML file (e.g.
# /about/index.html, /de/services/index.html) so Google gets real content per
# URL. Rewriting all paths to the homepage would destroy that. Instead we serve
# the prerendered files, and only fall back to Nuxt's client-rendered shell
# (/200.html) for any route that wasn't prerendered.

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files and directories as-is (assets, prerendered pages).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map /path -> /path/index.html (Nuxt emits directory-style pages).
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ /$1/index.html [L]

    # Non-prerendered route: hand off to Nuxt's client shell (HTTP 200).
    RewriteRule ^ /200.html [L]
</IfModule>

# Genuine not-found pages get Nuxt's prerendered 404 with a real 404 status.
ErrorDocument 404 /404.html
